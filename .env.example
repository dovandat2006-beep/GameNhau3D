PORT=3001
HOST=0.0.0.0
# Separate origins with commas. Set the exact HTTPS public origin in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,http://127.0.0.1:5173
# A reverse proxy on the same host: set TRUST_PROXY=loopback, never blindly true.
TRUST_PROXY=
# Public WebSocket URL (wss:// in production); HTTP API derived from this URL.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-long-random-secret
# HTTPS endpoint /api/livekit/webhook must be configured in LiveKit.
LIVEKIT_WEBHOOK_ENABLED=false
# Mac local setup: npm run voice:local generates private keys/webhook, then npm run dev.
# Linux compose/Caddy: DNS A records must point to the VPS; no https:// prefix.
GAME_DOMAIN=quan.example.com
VOICE_DOMAIN=voice.example.com
# Print aggregate CPU/RSS/event-loop/network counters (no session tokens).
LOG_METRICS=false

# Private persistent player feedback (not served by the web app).
DATA_DIR=data
